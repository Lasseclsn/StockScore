# SEC EDGAR requires no API key, only a descriptive User-Agent (name/app + contact)
# on every request — otherwise requests are blocked with a 403.
SEC_USER_AGENT: "YourAppName your-email@example.com"

Alpha_Vantage_API_KEY: "your_alpha_vantage_key_here"

# LLM — API Key + Provider name (deepseek | openai | gemini | groq)
LLM_API_KEY: "your_llm_api_key_here"
LLM_PROVIDER: "deepseek"

# Optional: override the default model for the chosen provider
# LLM_MODEL: "deepseek-chat"

# Optional: custom endpoint (e.g. local Ollama)
# LLM_URL: "http://localhost:11434/v1/chat/completions"
# LLM_MODEL: "llama3"
